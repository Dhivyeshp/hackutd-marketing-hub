# =============================================================================
# HackUTD Marketing Hub — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit real secrets.
#
# SESSION_SECRET must be the SAME value across all team members' .env.local
# and in Vercel. Generate once, share securely:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- ClickUp ---
CLICKUP_API_KEY=pk_your_clickup_api_key
CLICKUP_LIST_ID=your_clickup_list_id
CLICKUP_TEAM_ID=your_clickup_team_id

# --- Notion ---
NOTION_API_KEY=ntn_your_notion_api_key
NOTION_DATABASE_ID=your_notion_database_id
NOTION_CALENDAR_URL=https://www.notion.so/your-calendar-page

# --- Resend (email) ---
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=hub@hackutd.com

# --- Auth ---
# Invite code for new member self-onboarding
INVITE_CODE=HACKUTD2026

# --- Security ---
# Generate once and share with all team members + Vercel:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_session_secret_min_32_chars_random

# Shared secret between Google Apps Script and /api/requests
GAS_SECRET=your_gas_secret

# Used by Vercel cron to authenticate /api/cron/* calls
CRON_SECRET=your_cron_secret

# --- Google Sheets (roster + request intake) ---
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheets_spreadsheet_id
GOOGLE_SHEETS_GID=your_google_sheets_gid
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Google Drive folder links ---
DRIVE_ROOT_URL=https://drive.google.com/drive/folders/your-root-folder-id
DRIVE_DESIGN_URL=
DRIVE_UIUX_URL=
DRIVE_CONTENT_URL=
DRIVE_OUTREACH_URL=
DRIVE_BRAND_URL=
DRIVE_FINALS_URL=

# --- Figma ---
DESIGN_FIGMA_URL=
UIUX_FIGMA_URL=

# --- Public client-side mirrors (must match DRIVE_* and FIGMA_* above) ---
NEXT_PUBLIC_DRIVE_ROOT_URL=https://drive.google.com/drive/folders/your-root-folder-id
NEXT_PUBLIC_DRIVE_DESIGN_URL=
NEXT_PUBLIC_DRIVE_UIUX_URL=
NEXT_PUBLIC_DRIVE_CONTENT_URL=
NEXT_PUBLIC_DRIVE_OUTREACH_URL=
NEXT_PUBLIC_DRIVE_BRAND_URL=
NEXT_PUBLIC_DRIVE_FINALS_URL=
NEXT_PUBLIC_DESIGN_FIGMA_URL=
NEXT_PUBLIC_UIUX_FIGMA_URL=
